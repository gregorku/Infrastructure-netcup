###############################################################################
#
# Infrastructure-netcup Project
#
# File:
#   .env.example
#
# Description:
#   Example environment configuration for the Infrastructure-netcup stack.
#
###############################################################################

###############################################################################
# General
###############################################################################

TZ=Europe/Prague

###############################################################################
# Docker Compose
###############################################################################

COMPOSE_PROJECT_NAME=infrastructure-netcup

###############################################################################
# Traefik
###############################################################################

TRAEFIK_VERSION=v3.6.22

# Public e-mail used for Let's Encrypt
TRAEFIK_ACME_EMAIL=gregorku@atlas.cz

# Public dashboard hostname
TRAEFIK_DOMAIN=traefik.example.com

###############################################################################
# CrowdSec
###############################################################################

CROWDSEC_VERSION=v1.7.8

#
# PostgreSQL backend (instead of the default SQLite),
# so alerts/decisions can be queried from Metabase.
#

CROWDSEC_DB_NAME=crowdsec

CROWDSEC_DB_USER=crowdsec

CROWDSEC_DB_PASSWORD=change_this_password

#
# Read-only role for Metabase (can SELECT, cannot write
# to CrowdSec's own operational data).
#

METABASE_RO_USER=metabase_ro

METABASE_RO_PASSWORD=change_this_password

###############################################################################
# Metabase
###############################################################################

METABASE_VERSION=v0.62.4.3

# External URL (through VPS/WireGuard)
PUBLIC_ADMIN_URL=https://10.100.100.1:9444

#
# Metabase gets its own dedicated port/URL (no subpath --
# see configs/traefik/traefik.yml, entryPoint "metabase").
#
# Requires a SEPARATE port-forward rule on your router/
# WireGuard gateway: <external port> -> 8444 (host),
# same way you already forward 9443 -> 8443 for PUBLIC_ADMIN_URL.
#

METABASE_PUBLIC_URL=https://10.100.100.1:9444

# PostgreSQL

POSTGRES_VERSION=17.10-alpine

METABASE_DB_NAME=metabase

METABASE_DB_USER=metabase

METABASE_DB_PASSWORD=change_this_password

###############################################################################
# Static IP addresses
###############################################################################

IP_TRAEFIK=10.40.0.10
IP_CROWDSEC=10.40.0.11
IP_METABASE=10.40.0.12
IP_POSTGRES_METABASE=10.40.0.13
IP_POSTGRES_CROWDSEC=10.40.0.14

# Optional second interface (public / DMZ network)
IP_TRAEFIK_PUBLIC=100.40.0.10

###############################################################################
# Persistent data
###############################################################################

DATA_DIR=/docker-data/infrastructure

###############################################################################
# Logging
###############################################################################

LOG_MAX_SIZE=20m
LOG_MAX_FILES=5
